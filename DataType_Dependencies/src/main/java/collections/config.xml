    		<value>1234567890</value>
    	</list>
    </property>
    <property name="Address">
    	<set>
    		<value>Hyderabad</value>
    		<value>Gajwel</value>
    		<value>Wargal</value>
    	</set>
    </property>
    <property name="Courses">
    	<map>
    		<entry key="DSA" value="Data Structures and Algorithms" />
    		<entry key="OS" value="Operating Sysetms"/>
    		<entry key="cn" value= "Computer Networks"/>
    	</map>
    </property>
